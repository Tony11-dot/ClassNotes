# ClassNotes — native iOS release automation.
#
# One command bumps the build number and ships to TestFlight:
#   fastlane beta
#
# Unlike ClassMate (Flutter → `flutter build ipa`), this is a native Xcode
# project, so we build with `gym` against the shared scheme. Signing is
# automatic and headless (the ASC API key lets Xcode create/renew profiles).

APP_PROJECT = "ClassNotes.xcodeproj"
SCHEME      = "ClassNotes"
TEAM_ID     = "NNFD7CKGLG"
BUNDLE_ID   = "com.classmate.notes"
IPA_DIR     = "build"
IPA_NAME    = "ClassNotes"

# ── Auth: App Store Connect API key ───────────────────────────────────────────
# ClassNotes uses its OWN key (Z5KM7D8NG8), kept in the ClassMate docs folder.
# We deliberately DON'T read ASC_KEY_ID from the shell here, because ~/.zshrc
# exports ClassMate's key (28AUQ58BDS) globally and would stomp this. ASC_KEY_PATH
# DOES fall back to env — CI (see .github/workflows/ship.yml) writes the key
# to a runner temp path and has no "~/Documents/ClassMate docs/" to put it in.
# The issuer UUID is account-wide, so it takes the same fallback pattern — it's
# an identifier, not a secret.
ASC_KEY_ID   = "Z5KM7D8NG8"
ASC_KEY_PATH = (ENV["ASC_KEY_PATH"] || "").strip.empty? ? \
                 File.expand_path("~/Documents/ClassMate docs/ClassNotes/AuthKey_Z5KM7D8NG8.p8") : \
                 ENV["ASC_KEY_PATH"].strip
ASC_ISSUER   = (ENV["ASC_ISSUER_ID"] || "").strip.empty? ? \
                 "51a27d98-8621-4258-a919-f335d14ba3f8" : ENV["ASC_ISSUER_ID"].strip

def asc_api_key
  unless File.exist?(ASC_KEY_PATH)
    UI.user_error!("ASC key not found at #{ASC_KEY_PATH}. Put the .p8 there or " \
                   "update ASC_KEY_PATH in fastlane/Fastfile.")
  end
  app_store_connect_api_key(
    key_id:       ASC_KEY_ID,
    issuer_id:    ASC_ISSUER,
    key_filepath: ASC_KEY_PATH,
    in_house:     false,
  )
end

# Without this, a bare `fastlane beta` (what the README and the runbook say to
# type) dies with "Could not find 'beta'" and only `fastlane ios beta` works —
# and fastlane still exits 0 on some paths, so a ship can look like it happened
# when nothing was built. iOS is the only platform here; make it the default.
default_platform(:ios)

platform :ios do

  desc "Headless signing repair: create+install an Apple Distribution cert + " \
       "App Store provisioning profile via the ASC API key. Run this only if a " \
       "build fails with \"No signing certificate ... found\"."
  lane :fix_signing do
    key = asc_api_key
    cert(
      api_key:     key,
      development: false,
      team_id:     TEAM_ID,
      output_path: "fastlane/certs",
    )
    sigh(
      api_key:            key,
      app_identifier:     BUNDLE_ID,
      development:        false,
      force:              true,
      provisioning_name:  "ClassNotes AppStore",
      team_id:            TEAM_ID,
      output_path:        "fastlane/profiles",
    )
    UI.success "✅ Distribution cert + App Store profile installed."
  end

  desc "Bump build number (from TestFlight), build, and upload to TestFlight."
  lane :beta do |options|
    key = asc_api_key

    # Derive the next build number from what's already on TestFlight, so the
    # ship is idempotent even if the local pbxproj number is stale or the bump
    # wasn't committed. First run after build 1 → uploads build 2.
    last = latest_testflight_build_number(
      api_key:        key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0,
    ) rescue 0
    next_build = last + 1
    increment_build_number(xcodeproj: APP_PROJECT, build_number: next_build)
    UI.message "📦 Building #{IPA_NAME} #{get_version_number(xcodeproj: APP_PROJECT, target: SCHEME)} (#{next_build})…"

    build_app(
      project:        APP_PROJECT,
      scheme:         SCHEME,
      configuration:  "Release",
      clean:          true,
      output_directory: IPA_DIR,
      output_name:    "#{IPA_NAME}.ipa",
      export_method:  "app-store",
      # -allowProvisioningUpdates alone just tries to use whatever Apple ID is
      # signed into Xcode's Accounts pane — which is why this passed on the dev
      # Mac (an account was already signed in there) and failed on a fresh CI
      # runner with "No Accounts: Add a new account in Accounts settings."
      # These three flags hand xcodebuild the ASC API key directly, so it can
      # create/renew the cert and profile with no Apple ID account at all.
      xcargs:         "-allowProvisioningUpdates " \
                       "-authenticationKeyPath \"#{ASC_KEY_PATH}\" " \
                       "-authenticationKeyID #{ASC_KEY_ID} " \
                       "-authenticationKeyIssuerID #{ASC_ISSUER}",
      export_options: {
        signingStyle: "automatic",
        teamID:       TEAM_ID,
      },
    )

    changelog = (options[:notes] && !options[:notes].strip.empty?) ? options[:notes] \
                : "ClassNotes beta #{next_build} — #{Time.now.strftime('%Y-%m-%d')}"
    upload_to_testflight(
      api_key:                           key,
      app_identifier:                    BUNDLE_ID,
      ipa:                               "#{IPA_DIR}/#{IPA_NAME}.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         changelog,
    )
    UI.success "✅ Uploaded ClassNotes (#{next_build}) to TestFlight!"
  end

  desc "Print the latest build number TestFlight has for ClassNotes — the " \
       "post-ship verification (read-only, uploads nothing)."
  lane :latest do
    build = latest_testflight_build_number(
      api_key:              asc_api_key,
      app_identifier:       BUNDLE_ID,
      initial_build_number: 0,
    )
    UI.success "TestFlight has ClassNotes build #{build}"
  end

  desc "Re-upload the last-built IPA to TestFlight (skip build)."
  lane :upload do
    upload_to_testflight(
      api_key:                           asc_api_key,
      app_identifier:                    BUNDLE_ID,
      ipa:                               "#{IPA_DIR}/#{IPA_NAME}.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "ClassNotes beta — #{Time.now.strftime('%Y-%m-%d')}",
    )
    UI.success "✅ Uploaded to TestFlight!"
  end


  # ── App Store (from the `ship` skill template, wired to this project's key) ──
  def ship_version
    get_version_number(xcodeproj: APP_PROJECT, target: SCHEME)
  end

  def app_store(submit:)
    key = asc_api_key
    shots = File.expand_path("screenshots", __dir__)
    # deliver creates this folder itself, so "exists" isn't "has screenshots";
    # an empty one would make the next run wipe the live set.
    has_shots = Dir[File.join(shots, "**/*.png")].any?
    metadata = File.expand_path("metadata", __dir__)
    upload_to_app_store(
      api_key: key, app_identifier: BUNDLE_ID, app_version: ship_version,
      metadata_path: metadata, skip_metadata: !Dir.exist?(metadata),
      screenshots_path: shots, skip_screenshots: !has_shots, overwrite_screenshots: has_shots,
      skip_binary_upload: true,
      build_number: latest_testflight_build_number(api_key: key, app_identifier: BUNDLE_ID, version: ship_version).to_s,
      # No app_review_information on purpose: deliver sets "sign-in required" to
      # false whenever no demo credentials are passed, and ClassNotes needs one.
      # The review contact and demo account already on App Store Connect stand.
      submission_information: {
        add_id_info_uses_idfa: false, export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      },
      submit_for_review: submit,
      reject_if_possible: submit,
      automatic_release: ENV["SHIP_AUTO_RELEASE"] != "0",
      force: true, run_precheck_before_submit: false, precheck_include_in_app_purchases: false
    )
  end

  desc "Print what exists on App Store Connect (read-only)."
  lane :check do
    asc_api_key
    require "spaceship"
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    record = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    version = record&.get_edit_app_store_version || record&.get_live_app_store_version
    UI.message("SHIP_CHECK bundle_id=#{BUNDLE_ID} version=#{ship_version}")
    UI.message("SHIP_CHECK bundle_registered=#{!bundle.nil?}")
    UI.message("SHIP_CHECK app_record=#{record ? "#{record.id} (#{record.name})" : "missing"}")
    UI.message("SHIP_CHECK store_version=#{version ? "#{version.version_string} #{version.app_store_state}" : "none"}")
    UI.message("SHIP_CHECK live_version=#{record&.get_live_app_store_version&.version_string || "none"}")
    UI.message("SHIP_CHECK metadata=#{Dir.exist?(File.expand_path("metadata", __dir__))} screenshots=#{Dir[File.expand_path("screenshots/**/*.png", __dir__)].size}")
  end

  desc "Push listing text/screenshots to the App Store version, no submission."
  lane(:listing) { app_store(submit: false) }

  desc "Attach the latest TestFlight build to the App Store version and submit for review."
  lane(:submit) { app_store(submit: true) }

end
