<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AI config, substituted from build settings (Config/Secrets.xcconfig).
	     Standard app keys are still generated by GENERATE_INFOPLIST_FILE. -->
	<key>GROQ_API_KEY</key>
	<string>$(GROQ_API_KEY)</string>
	<key>SUPPORT_AI_API_KEY</key>
	<string>$(SUPPORT_AI_API_KEY)</string>
	<key>SUPPORT_AI_MODEL</key>
	<string>$(SUPPORT_AI_MODEL)</string>
	<!-- App uses only standard HTTPS/TLS + Keychain (exempt encryption), so it
	     is exempt from export compliance. Declaring it here skips the App Store
	     Connect prompt on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
