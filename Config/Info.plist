<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOVA talks to our Railway proxy, which holds the Groq key server-side.
	     NO key is embedded in the app; in proxy mode the app authenticates with
	     the user's ClassMate session token. -->
	<key>SUPPORT_AI_BASE_URL</key>
	<string>https://classnotes-nova-proxy-production.up.railway.app/openai/v1</string>
	<key>SUPPORT_AI_MODE</key>
	<string>proxy</string>
	<key>SUPPORT_AI_MODEL</key>
	<string>llama-3.3-70b-versatile</string>
	<!-- App uses only standard HTTPS/TLS + Keychain (exempt encryption), so it
	     is exempt from export compliance. Declaring it here skips the App Store
	     Connect prompt on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
