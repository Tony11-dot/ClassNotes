// AI / Groq configuration — mirrors ClassMate's env-var names.
// (ClassMate: services/api/src/support/support.service.ts)
//
// Committed file: NO SECRETS. Put your real key ONLY in Secrets.local.xcconfig,
// which is gitignored. To enable NOVA app-wide (like ClassMate's server env),
// copy Secrets.local.example.xcconfig to Secrets.local.xcconfig and paste the
// key. Users can also enter their own key in Settings → NOVA (stored in the
// Keychain) — either channel works.

SUPPORT_AI_MODEL = llama-3.3-70b-versatile
GROQ_API_KEY =
SUPPORT_AI_API_KEY =

#include? "Secrets.local.xcconfig"

// These build settings are substituted into Config/Info.plist ($(VAR)) at build
// time, so AIConfig can read them at runtime — the channel that reaches
// TestFlight/Release.
